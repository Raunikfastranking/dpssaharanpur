RewriteEngine On

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect all HTTP to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect .php to clean URL (remove .php from the URL)
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally rewrite clean URLs to actual .php files (without .php in the URL)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+)$ $1.php [L]

# Friendly URL rewrites (you can change these rules based on your own URL structure)
RewriteRule ^home$ index.php [NC,L]
RewriteRule ^blog/([A-Za-z0-9-]+)$ detail.php?slug=$1 [NC,L]
RewriteRule ^view/([A-Za-z0-9-]+)$ detail-view.php?slug=$1 [NC,L]

# (Optional) Block direct access to .php files from the URL (if you don't want to allow it)
# RewriteCond %{REQUEST_URI} \.php$
# RewriteRule ^ - [F,L]
