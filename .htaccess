RewriteEngine On

<IfModule mod_headers.c>
Header set Access-Control-Allow-Origin "*"
Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# Redirect www to non-www (skip for localhost)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect all HTTP to HTTPS (skip for localhost)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect .php to clean URL (removes the .php extension) - skip proxy URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteCond %{REQUEST_URI} !/proxy/ [NC]
RewriteRule ^(.+)\.php$ $1 [R=301,L]

# Internally rewrite clean URLs to actual .php files (no .php in the URL)
# Works in both localhost subfolder and production root.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# Friendly URL rewrites
RewriteRule ^home$ index.php [NC,L]
RewriteRule ^blog/([A-Za-z0-9-]+)$ detail.php?slug=$1 [NC,L]
RewriteRule ^view/([A-Za-z0-9-]+)$ detail-view.php?slug=$1 [NC,L]

# (Optional) Block direct access to .php files from the URL (if you don't want to allow it)
# RewriteCond %{REQUEST_URI} \.php$
# RewriteRule ^ - [F,L]
